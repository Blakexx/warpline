"""warpline as a Bazel module: the reader (a Python library and its command) and its tests. A workspace depends on it
by `bazel_dep` at a commit; nothing here needs a GPU."""

module(name = "warpline", version = "0.1.0")

bazel_dep(name = "rules_python", version = "2.4.6")
bazel_dep(name = "rules_cc", version = "0.2.28")

#: THE HERMETIC CUDA TOOLKIT, a dev dependency: only warpline's own build sees these lines, so a workspace that depends on
#: warpline never resolves the module below or fetches the toolkit. NVIDIA's redistributable components, by the digest of the
#: release manifest (fsla-devtools' `pins/cuda_toolkit_pin.json`: CUDA 13.5, nvcc V13.5.37), unpacked into one repository that the
#: example kernels (`examples/`) are compiled with and the checker's saved outputs are tested against. The extension is
#: fsla-devtools' environment extension (public), at a commit; it is rules_cuda's redistributable form under another name,
#: with the disassemblers and `cu++filt` the checker calls, which rules_cuda's components do not name.
bazel_dep(name = "fsla_devtools", version = "0.1.0", dev_dependency = True)
git_override(
    module_name = "fsla_devtools",
    commit = "6781f2a752a4a95ce7566fd2b05942e0c27ffcb1",
    remote = "https://github.com/Blakexx/fsla-devtools.git",
)

environment = use_extension("@fsla_devtools//bazel:environment.bzl", "environment", dev_dependency = True)
environment.cuda_toolkit(
    name = "cuda_tools",
    build_file = "//toolchain:cuda_tools.BUILD",
    pin = "@fsla_devtools//pins:cuda_toolkit_pin.json",
)

#: THE HERMETIC HOST C++ TOOLCHAIN, from the same dev dependency: PyTorch's own -- its manylinux_2_28 builder's gcc-toolset
#: (GCC 13) on that builder's AlmaLinux 8 sysroot (glibc 2.28), the RPMs by digest (fsla-devtools' `pins/host_toolchain_pin.json`),
#: unpacked on rules_python's interpreter -- what compiles the host code of warpline's own tests and nvcc's host compiler
#: for the example kernels (`-ccbin`, examples/cuda.bzl). The machine's compiler is never detected (.bazelrc). A workspace
#: that depends on warpline registers its own C++ toolchain; these lines are never its.
python = use_extension("@rules_python//python/extensions:python.bzl", "python", dev_dependency = True)
use_repo(python, "python_3_14_host")

environment.host_toolchain(
    name = "host_toolchain",
    pin = "@fsla_devtools//pins:host_toolchain_pin.json",
    python = "@python_3_14_host//:python",
)

register_toolchains(
    "@host_toolchain//:toolchain",
    #: the rate probe's CUDA toolchain: the pinned toolkit above (`probes/probe.bzl`); a consumer registers its own
    "//toolchain:cuda_probe_toolchain",
    dev_dependency = True,
)

#: NSIGHT COMPUTE, the profiler `warpline run --profile` runs: the one fsla-devtools pins (`pins/nsight_compute_pin.json`), by its
#: archive's digest, unpacked as it lays itself out (`ncu` at the root, which `--toolkit` takes)
environment.pinned(
    name = "nsight_compute",
    build_file = "//toolchain:nsight_compute.BUILD",
    pin = "@fsla_devtools//pins:nsight_compute_pin.json",
)

#: THE DOC REFERENCES' TOOL, from the same dev dependency: `//docs:docrefs` pins every citation the docs make of the tree
#: (fsla-devtools' `fsla_devtools.docrefs`, `docs/BUILD.bazel`)
environment.docrefs(name = "docrefs")

#: THE HERMETIC CHECK'S CODE, from the same dev dependency: `//toolchain:hermetic` runs it on the toolchain's interpreter
#: (fsla-devtools' `hermetic_test`, `toolchain/BUILD.bazel`)
environment.hermetic(name = "hermetic")
use_repo(environment, "cuda_tools", "docrefs", "hermetic", "host_toolchain", "nsight_compute")
