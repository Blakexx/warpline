"""warpline as a Bazel module: the reader (a Python library and its command) and its tests. A workspace depends on it
by `bazel_dep` at a commit; nothing here needs a GPU."""

module(name = "warpline", version = "0.1.0")

bazel_dep(name = "rules_python", version = "2.4.6")
bazel_dep(name = "rules_cc", version = "0.2.28")

#: THE HERMETIC CUDA TOOLKIT, a dev dependency: only warpline's own build sees these lines, so a workspace that depends on
#: warpline never resolves the module below or fetches the toolkit. NVIDIA's redistributable components, by the digest of the
#: release manifest (`toolchain/cuda_toolkit_pin.json`: CUDA 13.0, nvcc V13.0.48), unpacked into one repository that the
#: example kernels (`examples/`) are compiled with and the checker's saved outputs are tested against. The extension is
#: rola-devtools' environment extension (public), at a commit; it is rules_cuda's redistributable form under another name,
#: with the disassemblers and `cu++filt` the checker calls, which rules_cuda's components do not name.
bazel_dep(name = "rola_devtools", version = "0.1.0", dev_dependency = True)
git_override(
    module_name = "rola_devtools",
    commit = "9045d81ede7f95b158f159d20eedfc1542a65cc4",
    remote = "https://github.com/Blakexx/rola-devtools.git",
)

environment = use_extension("@rola_devtools//bazel:environment.bzl", "environment", dev_dependency = True)
environment.cuda_toolkit(
    name = "cuda_tools",
    build_file = "//toolchain:cuda_tools.BUILD",
    pin = "//toolchain:cuda_toolkit_pin.json",
)
use_repo(environment, "cuda_tools")

#: THE MIRROR'S CHECK: rola-devtools' mirror tool at the commit `.github/workflows/mirror.yml` installs (the one pin: change
#: both together). Fetched only when a target reads it (so a workspace depending on warpline never fetches it), as source: that commit
#: predates rola-devtools' own Bazel module -- and read only by `//:mirror_declarations`.
git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")

git_repository(
    name = "rola_devtools_mirror",
    build_file_content = """
load("@rules_python//python:defs.bzl", "py_library")

py_library(
    name = "mirror",
    srcs = ["rola_devtools/__init__.py", "rola_devtools/mirror.py"],
    imports = ["."],
    visibility = ["//visibility:public"],
)
""",
    commit = "3318da1c25ecf4f46389b204a23e93ec3a4eb23a",
    remote = "https://github.com/Blakexx/rola-devtools.git",
)
