load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_python//python:packaging.bzl", "py_package", "py_wheel")

package(default_visibility = ["//visibility:public"])

#: `checker.bzl` (the checker's test macro) and the command's entry, for a target in another package
exports_files(["checker.bzl", "warpline_cli.py"])

#: the reader: the record's format, its checks, regions, the wait join, the critical path, the average window, the
#: merge of runs, the Perfetto writer, the importers, a profiler's sampled series (period, checks, fold), their
#: alignment under the stamps, and a set of variants
#: (the checker module, `warpline/checker/`, is in the same library: docs/checker.md)
py_library(
    name = "warpline",
    srcs = glob(["warpline/**/*.py"]),
    imports = ["."],
)

#: `bazel run //:cli -- check|path|step|window|merge|perfetto <record>`, `fold|overlay|set` for the sampled layer
py_binary(
    name = "cli",
    srcs = ["warpline_cli.py"],
    main = "warpline_cli.py",
    deps = [":warpline"],
)

#: `bazel run //:launch_set -- build/set_synth`: a synthetic launch (a plain variant and a stamped variant, three runs
#: each, the stamped record carrying the launch's two edges) written under a directory; the tests use the same generator
py_binary(
    name = "launch_set",
    srcs = ["tests/launch_gen.py", "tests/helpers.py"],
    main = "tests/launch_gen.py",
    deps = [":warpline"],
)

#: the stamp's two headers: `warpline/entry.hpp` and `warpline/host.hpp` are plain C++17 (this target needs no CUDA);
#: `warpline/stamp.cuh` is for nvcc: the example that includes it is built by `//examples:two_roles`, with the pinned toolkit
#: THE IN-KERNEL HALF's headers, for a workspace whose own rules compile its kernels: `includes` puts `include/` on
#: the path of a cc target that depends on it, and the files are there as data for a tool that calls a compiler itself.
cc_library(
    name = "stamp",
    hdrs = ["include/warpline/entry.hpp", "include/warpline/stamp.cuh"],
    includes = ["include"],
)

filegroup(
    name = "headers",
    srcs = glob(["include/warpline/*"]),
)

cc_library(
    name = "host",
    hdrs = ["include/warpline/entry.hpp", "include/warpline/host.hpp"],
    includes = ["include"],
)

#: hand-made rows written as records through the host header, for tests/test_host.py (no GPU)
cc_binary(
    name = "host_gen",
    srcs = ["tests/host_gen.cc"],
    copts = ["-std=c++17"],
    deps = [":host"],
)

py_test(
    name = "test_host",
    srcs = ["tests/test_host.py"],
    args = ["$(rootpath :host_gen)"],
    data = [":host_gen"],
    imports = ["tests"],
    main = "tests/test_host.py",
    deps = [":warpline"],
)

[py_test(
    name = test[len("tests/"):-len(".py")],
    srcs = [test] + glob(["tests/helpers.py", "tests/launch_gen.py"]),
    imports = ["tests"],
    main = test,
    #: the placement's tests resample the runs of many synthetic launches (the spread's coverage over seeds)
    size = "large" if test == "tests/test_placement.py" else "medium",
    deps = [":warpline"],
) for test in glob(["tests/test_*.py"], exclude = ["tests/test_host.py", "tests/test_checker_*.py"])]

#: THE CHECKER's tests (docs/checker.md): readers, the kernel model, the rules on their fixtures. The fixtures are text
#: a vendor tool printed (`tests/checker_fixtures/`), so no test needs a GPU or the CUDA toolkit.
[py_test(
    name = test[len("tests/"):-len(".py")],
    srcs = [test],
    data = glob(["tests/checker_fixtures/**"]),
    imports = ["tests"],
    main = test,
    deps = [":warpline"],
) for test in glob(["tests/test_checker_*.py"])]

#: THE MIRROR'S DECLARATIONS, checked before a push: every tracked path is declared `ships` or `private` in
#: `.github/mirror/declarations.json`, by the tool the mirror workflow runs (`rola_devtools.mirror --check`). It reads
#: the checkout's git index, so it runs in the checkout, never cached (rola's `checkout_test`). The workflow's tripwire
#: over the export (private-shaped strings, agent files) is not part of it: docs/mirror.md.
py_test(
    name = "mirror_declarations",
    size = "small",
    srcs = ["tests/mirror_declarations.py"],
    data = ["MODULE.bazel"],
    main = "tests/mirror_declarations.py",
    tags = ["external", "local"],
    deps = ["@rola_devtools_mirror//:mirror"],
)

#: THE EXAMPLE KERNELS' TESTS, on the pinned toolkit (`examples/`, MODULE.bazel's `cuda_tools`): the checker's kernels, compiled,
#: reproduce the committed fixtures (a regenerated one that differs fails: the committed files are the contract), and the stamp
#: example's build holds no clock read with both switches off. Neither needs a GPU or a CUDA install.
py_test(
    name = "fixtures_regenerated",
    size = "medium",
    srcs = ["tests/fixtures_regenerated.py"],
    args = [
        "%s:$(rootpath //examples/checker:%s.%s):$(rootpath tests/checker_fixtures/%s/kernel.%s)" % (kind, kernel, ext, fixture, kind_ext)
        for kernel, fixture, files in [
            ("steps", "example", [("sass", "sass", "sass"), ("dot", "cfg.dot", "cfg.dot"), ("res", "res", "res"), ("names", "names", "names"), ("ptxas", "ptxas", "ptxas")]),
            ("stages", "stages", [("sass", "sass", "sass"), ("dot", "cfg.dot", "cfg.dot"), ("res", "res", "res"), ("names", "names", "names"), ("ptxas", "ptxas", "ptxas")]),
            ("collectives", "collectives", [("sass", "sass", "sass"), ("dot", "cfg.dot", "cfg.dot"), ("res", "res", "res"), ("names", "names", "names")]),
            ("mma", "mma", [("sass", "sass", "sass"), ("dot", "cfg.dot", "cfg.dot"), ("res", "res", "res"), ("names", "names", "names")]),
        ]
        for kind, ext, kind_ext in files
    ],
    data = [
        "//examples/checker:%s.%s" % (kernel, ext)
        for kernel in ["steps", "stages", "collectives", "mma"]
        for ext in ["sass", "cfg.dot", "res", "names"] + (["ptxas"] if kernel in ["steps", "stages"] else [])
    ] + glob(["tests/checker_fixtures/%s/kernel.*" % d for d in ["example", "stages", "collectives", "mma"]]),
    main = "tests/fixtures_regenerated.py",
)

py_test(
    name = "stamp_example_test",
    size = "small",
    srcs = ["tests/stamp_example.py"],
    args = ["$(rootpath //examples:two_roles.sass)"],
    data = ["//examples:two_roles.sass"],
    main = "tests/stamp_example.py",
)

#: THE PACKAGE, built here and nowhere else: `bazel build //:wheel` writes the wheel a user installs with pip; its
#: metadata is this target's
py_package(
    name = "package",
    packages = ["warpline"],
    deps = [":warpline"],
)

py_wheel(
    name = "wheel",
    distribution = "warpline",
    version = "0.1.0",
    python_tag = "py3",
    python_requires = ">=3.9",
    summary = "A kernel's timeline, read out of stamps: a name and a clock value on a warp's lane.",
    license = "Apache-2.0",
    entry_points = {"console_scripts": ["warpline = warpline.__main__:main"]},
    deps = [":package"],
)
