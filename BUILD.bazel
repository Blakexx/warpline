load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_python//python:packaging.bzl", "py_package", "py_wheel")

package(default_visibility = ["//visibility:public"])

#: `checker.bzl` (the checker's macros) and the checker command's entry, for a target in another package
exports_files(["checker.bzl", "warpline/checker/__main__.py"])

#: THE SHARED PART, the two modules' only common code: the package's version and the one command's assembly
#: (`warpline/command.py`: the parser, each module's verbs under its heading, no verb two modules share)
py_library(
    name = "shared",
    srcs = ["warpline/__init__.py", "warpline/__main__.py", "warpline/command.py"],
    imports = ["."],
)

#: THE RECORDER (`warpline/recorder/`, docs/guide.md): the in-kernel stamps' records read by Python: the record's format,
#: its checks (`verify`), regions, the wait join, the critical path, the average window, the merge of runs, the Perfetto
#: writer, the importers, a profiler's sampled series (period, checks, fold), their alignment under the stamps, and a set of
#: variants. The in-kernel half it reads (`include/`) is `:stamp` and `:host` below. Depends on `:shared` and on nothing of the checker.
py_library(
    name = "recorder",
    srcs = glob(["warpline/recorder/**/*.py"]),
    imports = ["."],
    deps = [":shared"],
)

#: THE CHECKER (`warpline/checker/`, docs/checker.md): the vendor tools' outputs (SASS, the control-flow graph, resource usage,
#: the build's notices, a profiler's exports) read into the kernel model, the rules, manifest and declarations. Depends on
#: `:shared` and on nothing of the recorder. `checker.bzl`'s macros depend on this target and on `:checker_cli` alone.
py_library(
    name = "checker",
    srcs = glob(["warpline/checker/**/*.py"]),
    imports = ["."],
    deps = [":shared"],
)

#: both modules and the one command, which is what the wheel packages: a consumer of one module depends on that module's target
py_library(
    name = "warpline",
    deps = [":checker", ":recorder"],
)

#: `bazel run //:cli -- <verb> ...`: the one command, both modules' verbs (`--help` lists them by module)
py_binary(
    name = "cli",
    srcs = ["warpline/__main__.py"],
    main = "warpline/__main__.py",
    deps = [":warpline"],
)

#: `bazel run //:recorder_cli -- verify|summary|path|... <record>`: the recorder's verbs alone
py_binary(
    name = "recorder_cli",
    srcs = ["warpline/recorder/__main__.py"],
    main = "warpline/recorder/__main__.py",
    deps = [":recorder"],
)

#: `bazel run //:checker_cli -- check|manifest|compare ...`: the checker's verbs alone (what `checker.bzl` runs)
py_binary(
    name = "checker_cli",
    srcs = ["warpline/checker/__main__.py"],
    main = "warpline/checker/__main__.py",
    deps = [":checker"],
)

#: `bazel run //:launch_set -- /tmp/set_synth`: a synthetic launch (a plain variant and a stamped variant, three runs
#: each, the stamped record carrying the launch's two edges) written under a directory; the tests use the same generator
py_binary(
    name = "launch_set",
    srcs = ["tests/recorder/launch_gen.py", "tests/recorder/helpers.py"],
    main = "tests/recorder/launch_gen.py",
    deps = [":recorder"],
)

#: the stamp's two headers: `warpline/entry.hpp` and `warpline/host.hpp` are plain C++17 (this target needs no CUDA);
#: `warpline/stamp.cuh` is for nvcc: the example that includes it is built by `//examples:two_roles`, with the pinned toolkit
#: THE IN-KERNEL HALF's headers, for a workspace whose own rules compile its kernels: `includes` puts `include/` on
#: the path of a cc target that depends on it, and the files are there as data for a tool that calls a compiler itself.
cc_library(
    name = "stamp",
    hdrs = ["include/warpline/entry.hpp", "include/warpline/stamp.cuh"],
    includes = ["include"],
)

filegroup(
    name = "headers",
    srcs = glob(["include/warpline/*"]),
)

cc_library(
    name = "host",
    hdrs = ["include/warpline/entry.hpp", "include/warpline/host.hpp"],
    includes = ["include"],
)

#: hand-made rows written as records through the host header, for tests/recorder/test_host.py (no GPU)
cc_binary(
    name = "host_gen",
    srcs = ["tests/recorder/host_gen.cc"],
    copts = ["-std=c++17"],
    deps = [":host"],
)

py_test(
    name = "recorder_test_host",
    srcs = ["tests/recorder/test_host.py"],
    args = ["$(rootpath :host_gen)"],
    data = [":host_gen"],
    imports = ["tests"],
    main = "tests/recorder/test_host.py",
    deps = [":recorder"],
)

#: THE RECORDER'S TESTS (`tests/recorder/`): on synthetic records and launches; they import the recorder alone
[py_test(
    name = "recorder_" + test[len("tests/recorder/"):-len(".py")],
    srcs = [test] + glob(["tests/__init__.py", "tests/recorder/__init__.py", "tests/recorder/helpers.py", "tests/recorder/launch_gen.py"]),
    imports = ["tests"],
    main = test,
    #: the placement's tests resample the runs of many synthetic launches (the spread's coverage over seeds)
    size = "large" if test == "tests/recorder/test_placement.py" else "medium",
    deps = [":recorder"],
) for test in glob(["tests/recorder/test_*.py"], exclude = ["tests/recorder/test_host.py"])]

#: THE CHECKER'S TESTS (`tests/checker/`, docs/checker.md): readers, the kernel model, the rules on their fixtures. The fixtures are text
#: a vendor tool printed (`tests/checker/fixtures/`), so no test needs a GPU or the CUDA toolkit. They import the checker alone.
[py_test(
    name = "checker_" + test[len("tests/checker/"):-len(".py")],
    srcs = [test] + glob(["tests/__init__.py", "tests/checker/__init__.py"]),
    data = glob(["tests/checker/fixtures/**"]),
    imports = ["tests"],
    main = test,
    deps = [":checker"],
) for test in glob(["tests/checker/test_*.py"])]

#: THE ONE COMMAND's test (`tests/test_command.py`): each module's verbs under its heading, no verb in two modules, and
#: neither module's sources import the other.
py_test(
    name = "test_command",
    srcs = ["tests/test_command.py", "tests/__init__.py"],
    imports = ["tests"],
    main = "tests/test_command.py",
    deps = [":warpline"],
)

#: the kernels the three step rules (`step_serialized`, `accumulator_moved`, `wait_all_with_work`) are shown on, each with the rules whose
#: fixture directory (`tests/checker/fixtures/rules/<rule>/<kernel>/`) holds its saved outputs
_STEP_RULE_KERNELS = {
    "serialized": ["step_serialized", "accumulator_moved", "wait_all_with_work"],
    "fenced": ["step_serialized", "accumulator_moved"],
    "mixed_shapes": ["step_serialized", "accumulator_moved"],
    "wait_all_work": ["wait_all_with_work"],
    "wait_all_reads": ["wait_all_with_work"],
}

#: the kernels the rule `load_behind_load` is shown on (`examples/checker/<kernel>.cu`), each with its fixture directory under
#: `tests/checker/fixtures/rules/load_behind_load/`
_LOAD_KERNELS = {
    "loads_together": "together",
    "loads_split": "split",
}

#: the kernels the rule `loop_held` is shown on (`examples/checker/<kernel>.cu`, compiled with line information), each with its fixture
#: directory under `tests/checker/fixtures/rules/loop_held/`
_HELD_KERNELS = {
    "held_few": "few",
    "held_many": "many",
    "held_none": "none",
}

#: THE EXAMPLE KERNELS' TESTS, on the pinned toolkit (`examples/`, MODULE.bazel's `cuda_tools`): the checker's kernels, compiled,
#: reproduce the committed fixtures (a regenerated one that differs fails: the committed files are the contract), and the stamp
#: example's build holds no clock read with both switches off. Neither needs a GPU or a CUDA install.
py_test(
    name = "fixtures_regenerated",
    size = "medium",
    srcs = ["tests/checker/fixtures_regenerated.py"],
    args = [
        "%s:$(rootpath //examples/checker:%s.%s):$(rootpath tests/checker/fixtures/%s/kernel.%s)" % (kind, kernel, ext, fixture, kind_ext)
        for kernel, fixture, files in [
            ("steps", "example", [("sass", "sass", "sass"), ("dot", "cfg.dot", "cfg.dot"), ("res", "res", "res"), ("names", "names", "names"), ("ptxas", "ptxas", "ptxas")]),
            ("stages", "stages", [("sass", "sass", "sass"), ("dot", "cfg.dot", "cfg.dot"), ("res", "res", "res"), ("names", "names", "names"), ("ptxas", "ptxas", "ptxas")]),
            ("collectives", "collectives", [("sass", "sass", "sass"), ("dot", "cfg.dot", "cfg.dot"), ("res", "res", "res"), ("names", "names", "names")]),
            ("mma", "mma", [("sass", "sass", "sass"), ("dot", "cfg.dot", "cfg.dot"), ("res", "res", "res"), ("names", "names", "names")]),
        ]
        for kind, ext, kind_ext in files
    ] + [
        "%s:$(rootpath //examples/checker:%s.%s):$(rootpath tests/checker/fixtures/rules/%s/%s/kernel.%s)" % (kind, kernel, ext, rule, kernel, ext)
        for kernel, rules in _STEP_RULE_KERNELS.items()
        for rule in rules
        for kind, ext in [("sass", "sass"), ("dot", "cfg.dot"), ("res", "res"), ("names", "names")]
    ] + [
        "%s:$(rootpath //examples/checker:%s.%s):$(rootpath tests/checker/fixtures/rules/loop_held/%s/kernel.%s)" % (kind, kernel, ext, fixture, ext)
        for kernel, fixture in _HELD_KERNELS.items()
        for kind, ext in [("sass", "sass"), ("dot", "cfg.dot"), ("res", "res"), ("names", "names"), ("lines", "lines")]
    ] + [
        "%s:$(rootpath //examples/checker:%s.%s):$(rootpath tests/checker/fixtures/rules/load_behind_load/%s/kernel.%s)" % (kind, kernel, ext, fixture, ext)
        for kernel, fixture in _LOAD_KERNELS.items()
        for kind, ext in [("sass", "sass"), ("dot", "cfg.dot"), ("res", "res"), ("names", "names")]
    ],
    data = [
        "//examples/checker:%s.%s" % (kernel, ext)
        for kernel in ["steps", "stages", "collectives", "mma"]
        for ext in ["sass", "cfg.dot", "res", "names"] + (["ptxas"] if kernel in ["steps", "stages"] else [])
    ] + [
        "//examples/checker:%s.%s" % (kernel, ext)
        for kernel in _STEP_RULE_KERNELS
        for ext in ["sass", "cfg.dot", "res", "names"]
    ] + [
        "//examples/checker:%s.%s" % (kernel, ext)
        for kernel in _HELD_KERNELS
        for ext in ["sass", "cfg.dot", "res", "names", "lines"]
    ] + [
        "//examples/checker:%s.%s" % (kernel, ext)
        for kernel in _LOAD_KERNELS
        for ext in ["sass", "cfg.dot", "res", "names"]
    ] + glob(["tests/checker/fixtures/rules/load_behind_load/*/kernel.*"]) + glob(["tests/checker/fixtures/%s/kernel.*" % d for d in ["example", "stages", "collectives", "mma"]]) + glob(["tests/checker/fixtures/rules/loop_held/*/kernel.*"]) + [
        "tests/checker/fixtures/rules/%s/%s/kernel.%s" % (rule, kernel, ext)
        for kernel, rules in _STEP_RULE_KERNELS.items()
        for rule in rules
        for ext in ["sass", "cfg.dot", "res", "names"]
    ],
    main = "tests/checker/fixtures_regenerated.py",
)

#: THE CHECKER'S MANIFEST FROM THE GRAPH (`warpline_check`, `examples/checker/`): the manifest the build's first action wrote for each
#: example kernel is the manifest of the committed fixtures, and the declarations that pass in the build refuse when they are
#: changed. Needs no GPU or CUDA install.
py_test(
    name = "graph_manifest_test",
    size = "medium",
    srcs = ["tests/checker/graph_manifest.py"],
    args = [
        "%s:$(rootpath //examples/checker:%s_manifest):$(rootpath //examples/checker:%s.declarations.json):tests/checker/fixtures/%s/kernel" % (kernel, kernel, kernel, fixture)
        for kernel, fixture in [("steps", "example"), ("mma", "mma"), ("collectives", "collectives")]
    ],
    data = [
        "//examples/checker:%s_manifest" % kernel
        for kernel in ["steps", "mma", "collectives"]
    ] + [
        "//examples/checker:%s.declarations.json" % kernel
        for kernel in ["steps", "mma", "collectives"]
    ] + glob(["tests/checker/fixtures/%s/kernel.*" % d for d in ["example", "mma", "collectives"]]),
    main = "tests/checker/graph_manifest.py",
    deps = [":checker"],
)

#: A LINE INSERTED ABOVE A LOOP MOVES NO FIELD (`examples/checker/shifted/held_many.cu`): the build's manifests of `held_many` and of
#: the same kernel with lines inserted above its loops have the same field paths and values.
py_test(
    name = "graph_shifted_test",
    size = "small",
    srcs = ["tests/checker/graph_shifted.py"],
    args = ["$(rootpath //examples/checker:manifest_manifest)", "$(rootpath //examples/checker:shifted_manifest)"],
    data = ["//examples/checker:manifest_manifest", "//examples/checker:shifted_manifest"],
    main = "tests/checker/graph_shifted.py",
    deps = [":checker"],
)

py_test(
    name = "stamp_example_test",
    size = "small",
    srcs = ["tests/recorder/stamp_example.py"],
    args = ["$(rootpath //examples:two_roles.sass)"],
    data = ["//examples:two_roles.sass"],
    main = "tests/recorder/stamp_example.py",
)

#: THE PACKAGE, built here and nowhere else: `bazel build //:wheel` writes the wheel a user installs with pip; its
#: metadata is this target's
py_package(
    name = "package",
    packages = ["warpline"],
    deps = [":warpline"],
)

py_wheel(
    name = "wheel",
    distribution = "warpline",
    version = "0.1.0",
    python_tag = "py3",
    python_requires = ">=3.9",
    summary = "A kernel's timeline, read out of stamps: a name and a clock value on a warp's lane.",
    license = "Apache-2.0",
    entry_points = {"console_scripts": ["warpline = warpline.command:run"]},
    deps = [":package"],
)
