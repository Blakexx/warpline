load("//:checker.bzl", "warpline_check", "warpline_check_test")
load("//examples:cuda.bzl", "kernel_outputs")

#: the hermetic check (`//toolchain:hermetic`) reads the checker's actions on the kernels
package(default_visibility = ["//toolchain:__pkg__"])

exports_files(glob(["*.declarations.json"]), visibility = ["//visibility:public"])

#: the checker as a test on a kernel: saved tool outputs of a small kernel (`tile.sass`, `tile.cfg.dot`, `tile.res`)
#: against the project's declarations, with the build's saved messages (`tile.ptxas`) read against the module's notice
#: ledger as the project's own `ledger.json` overrides it, and the project's notes (in `declarations.json`).
#: Needs no GPU and no CUDA toolkit; a real target passes `binary = ":your_kernel"` (a cc target, a fatbin or a cubin) instead of `fixture`, and the toolkit's `cuobjdump` and `nvdisasm` on PATH.
warpline_check_test(
    name = "tile_check",
    declare = "declarations.json",
    fixture = "tile",
    ledger = "ledger.json",
    notices = ["tile.ptxas"],
)

#: THE KERNELS, COMPILED with the pinned toolkit (`examples/cuda.bzl`, MODULE.bazel's `cuda_tools`): each example kernel's saved
#: tool outputs, regenerated. `//:fixtures_regenerated` compares them with the committed `tests/checker/fixtures/`.
#: Dev only: a workspace that depends on warpline never loads this package's CUDA rules.
kernel_outputs(name = "steps", src = "steps.cu", arch = "sm_90a", visibility = ["//visibility:public"])

kernel_outputs(name = "stages", src = "stages.cu", arch = "sm_90a", visibility = ["//visibility:public"])

kernel_outputs(name = "collectives", src = "collectives.cu", arch = "sm_80", visibility = ["//visibility:public"])

kernel_outputs(name = "mma", src = "mma.cu", arch = "sm_80", visibility = ["//visibility:public"])

#: the kernels the three step rules (`step_serialized`, `accumulator_moved`, `wait_all_with_work`) are shown on, one function each
[kernel_outputs(name = kernel, src = kernel + ".cu", arch = "sm_90a", visibility = ["//visibility:public"]) for kernel in [
    "serialized",
    "fenced",
    "mixed_shapes",
    "wait_all_work",
    "wait_all_reads",
]]

#: the kernels the rule `load_behind_load` is shown on
[kernel_outputs(name = kernel, src = kernel + ".cu", arch = "sm_90a", visibility = ["//visibility:public"]) for kernel in [
    "loads_together",
    "loads_split",
]]

#: the kernels the rule `loop_held` is shown on, compiled with line information (`<name>.lines`: the disassembly with source-line marks)
[kernel_outputs(name = kernel, src = kernel + ".cu", arch = "sm_90a", lines = True, visibility = ["//visibility:public"]) for kernel in [
    "held_few",
    "held_many",
    "held_none",
]]

#: the kernel whose registers are read by their life ranges and whose source by its inline frames, compiled with line information:
#: `ranges.life` (`nvdisasm --print-life-ranges`) and `ranges.inline` (`nvdisasm --print-line-info-inline`) beside its outputs
kernel_outputs(name = "ranges", src = "ranges.cu", arch = "sm_90a", lines = True, visibility = ["//visibility:public"])

[genrule(
    name = "ranges_" + kind,
    srcs = [":ranges.cubin"],
    outs = ["ranges." + kind],
    cmd = "$(execpath @cuda_tools//:bin/nvdisasm) %s $(execpath :ranges.cubin) > $@" % flag,
    tools = ["@cuda_tools//:bin/nvdisasm"],
    visibility = ["//visibility:public"],
) for kind, flag in [("life", "--print-life-ranges"), ("inline", "--print-line-info-inline")]]

#: the kernel whose launch bound the assembler discards: its `bound.ptxas` holds the notice the base ledger's
#: `launch_bound_discarded` row counts
kernel_outputs(name = "bound", src = "bound.cu", arch = "sm_90a", visibility = ["//visibility:public"])

#: THE CHECKER AS TWO BUILD ACTIONS (`warpline_check`, docs/checker-manifest.md) on the compiled example kernels: the manifest of the
#: cubin, then their comparison with the declarations (`*.declarations.json`); a refusal fails the build. The pinned toolkit
#: runs `cuobjdump`, `nvdisasm` and `cu++filt`: no CUDA install. `:steps_check` also reads the build's messages (`steps.ptxas`).
warpline_check(
    name = "steps_check",
    binary = ":steps.cubin",
    declarations = "steps.declarations.json",
    notices = [":steps.ptxas"],
    toolkit = "@cuda_tools//:toolkit",
)

warpline_check(
    name = "mma_check",
    binary = ":mma.cubin",
    declarations = "mma.declarations.json",
    toolkit = "@cuda_tools//:toolkit",
)

warpline_check(
    name = "collectives_check",
    binary = ":collectives.cubin",
    declarations = "collectives.declarations.json",
    toolkit = "@cuda_tools//:toolkit",
)

#: the same, on a kernel compiled with line information, with its `<name>.lines` (`lines =`): the manifest names the source lines that made
#: what a loop holds (`loop_held`); the declaration is the figure's bound
warpline_check(
    name = "held_check",
    binary = ":held_many.cubin",
    declarations = "held.declarations.json",
    lines = ":held_many.lines",
    toolkit = "@cuda_tools//:toolkit",
)

#: the manifest's checkers (docs/checker-manifest.md) from the declarations file, on the same kernel: bounds, a hash of the loop's
#: figures, waivers, and the coverage check turned on (`"coverage": true`). `bazel build :manifest_check` passes; change a figure's
#: value or the hash in `manifest.declarations.json` and the build refuses.
warpline_check(
    name = "manifest_check",
    binary = ":held_many.cubin",
    declarations = "manifest.declarations.json",
    lines = ":held_many.lines",
    toolkit = "@cuda_tools//:toolkit",
)

#: THE SAME KERNEL WITH LINES INSERTED ABOVE ITS LOOPS (`shifted/held_many.cu`: a header comment and blank lines before the code): its
#: manifest has the same field paths and values as `held_many`'s (only the loops' `at` notes differ), so the same declarations, a
#: hash of the loops' figures included, pass on it. `//:graph_shifted_test` compares the two manifests.
kernel_outputs(name = "held_many_shifted", src = "shifted/held_many.cu", arch = "sm_90a", lines = True, visibility = ["//visibility:public"])

warpline_check(
    name = "shifted_check",
    binary = ":held_many_shifted.cubin",
    declarations = "manifest.declarations.json",
    lines = ":held_many_shifted.lines",
    toolkit = "@cuda_tools//:toolkit",
)

[filegroup(
    name = kernel + "_manifest",
    srcs = [":" + kernel + "_check"],
    output_group = "manifest",
    visibility = ["//visibility:public"],
) for kernel in ["manifest", "shifted"]]

#: the manifest files those checks wrote (the side output), for `//:graph_manifest_test`
[filegroup(
    name = kernel + "_manifest",
    srcs = [":" + kernel + "_check"],
    output_group = "manifest",
    visibility = ["//visibility:public"],
) for kernel in ["steps", "mma", "collectives"]]

#: THE COMPILER'S EXPANSIONS (docs/checker-rules.md#compiler-expansions): one kernel an expansion that the `expansion_*` rules
#: flag, and the clean forms none flags, compiled with line information (a finding names its source line)
_EXPANSIONS = [
    "int_division",
    "int_clean",
    "wide_integer",
    "wide_clean",
    "float_division",
    "float_sqrt",
    "float_reciprocal",
    "transcendental",
    "float_clean",
    "double_division",
    "slow_call",
]

[kernel_outputs(name = "expansion_" + kernel, src = "expansions/%s.cu" % kernel, arch = "sm_90a", lines = True, visibility = ["//visibility:public"]) for kernel in _EXPANSIONS]
