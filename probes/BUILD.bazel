"""THE RATE PROBES (docs/floor.md#the-probes): `rates.cu`, one program that measures each stream's rate on the card it runs on and
writes the rates table a floor is priced at, every row checked exactly. Built with the pinned toolkit (`@cuda_tools`); nothing
here needs a GPU to build. Dev only: a workspace that depends on warpline never loads this package's CUDA rules."""

load("//:checker.bzl", "warpline_check")
load("//examples:cuda.bzl", "host_and_device_binary", "kernel_outputs")

#: the program: `bazel-bin/probes/rates.bin rates.json` on a card writes its table (`//:record_floor_fixtures` runs it)
host_and_device_binary(
    name = "rates",
    src = "rates.cu",
    archs = ["sm_80", "sm_90a"],
    hdrs = [],
    includes = [],
    visibility = ["//visibility:public"],
)

#: THE WORK A TRIP IS THE SASS'S: the probes' kernels compiled for each architecture the program carries, and their loops'
#: class counts and instructions held exactly against the constants the program prices a trip at (`rates.declarations.json`)
[kernel_outputs(name = "rates_" + arch, src = "rates.cu", arch = arch, lines = True) for arch in ["sm_80", "sm_90a"]]

[warpline_check(
    name = "rates_%s_check" % arch,
    binary = ":rates_%s.cubin" % arch,
    declarations = "rates.declarations.json",
    lines = ":rates_%s.lines" % arch,
    toolkit = "@cuda_tools//:toolkit",
) for arch in ["sm_80", "sm_90a"]]
